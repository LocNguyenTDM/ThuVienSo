@model ThuVienSo.Models.TaiLieu
@{
    ViewBag.Title = "Đóng góp tài liệu số";
    var danhSachTheLoai = ViewBag.DanhSachTheLoai as List<ThuVienSo.Models.TheLoai> ?? new List<ThuVienSo.Models.TheLoai>();
    var danhSachTacGia = ViewBag.DanhSachTacGia as List<ThuVienSo.Models.TacGia> ?? new List<ThuVienSo.Models.TacGia>();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white p-4 border-0">
                    <h4 class="fw-bold mb-0"><i class="bi bi-cloud-upload me-2"></i>Đóng góp tài liệu số</h4>
                    <p class="small opacity-75 mb-0">Chia sẻ tri thức của bạn với cộng đồng độc giả.</p>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">
                    @using (Html.BeginForm("DongGop", "NguoiDoc", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3" })

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-bold text-dark">Tên tài liệu <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.TenTaiLieu, new { @class = "form-control rounded-3", placeholder = "Ví dụ: Giáo trình Lập trình C# nâng cao", required = "required" })
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Thể loại</label>
                                <select name="TheLoaiId" class="form-select rounded-3">
                                    <option value="">-- Chọn thể loại --</option>
                                    @foreach (var tl in danhSachTheLoai)
                                    {
                                        <option value="@tl.Id">@tl.TenTheLoai</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Tác giả</label>
                                <select name="TacGiaId" class="form-select rounded-3">
                                    <option value="">-- Chọn tác giả --</option>
                                    @foreach (var tg in danhSachTacGia)
                                    {
                                        <option value="@tg.Id">@tg.TenTacGia</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold text-dark">Mô tả tài liệu</label>
                                @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control rounded-3", rows = "4", placeholder = "Mô tả ngắn gọn về nội dung tài liệu..." })
                            </div>

                            <div class="col-12">
                                <div class="p-4 bg-light rounded-4 border border-dashed text-center">
                                    <label class="form-label fw-bold text-dark d-block mb-3">Chọn tệp tài liệu (PDF hoặc Word) <span class="text-danger">*</span></label>
                                    <input type="file" name="fileTaiLieu" class="form-control" accept=".pdf,.doc,.docx" required>
                                    <div class="form-text mt-2"><i class="bi bi-info-circle me-1"></i>Chỉ chấp nhận định dạng .pdf, .doc, .docx. Dung lượng tối đa 20MB.</div>
                                </div>
                            </div>

                            <div class="col-12 pt-3">
                                <div class="alert alert-info rounded-3 small">
                                    <i class="bi bi-info-circle-fill me-2"></i>Tài liệu sau khi tải lên sẽ được chuyển sang trạng thái <strong>Chờ duyệt</strong>. Thủ thư sẽ kiểm tra nội dung và phê duyệt trước khi tài liệu xuất hiện công khai trên hệ thống.
                                </div>
                            </div>

                            <div class="col-12 d-flex gap-2 pt-3">
                                <button type="submit" class="btn btn-primary px-5 py-2 fw-bold rounded-pill">
                                    <i class="bi bi-check-circle me-2"></i>Gửi đóng góp
                                </button>
                                <a href="@Url.Action("Index", "NguoiDoc")" class="btn btn-outline-secondary px-4 py-2 fw-bold rounded-pill">Hủy bỏ</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
