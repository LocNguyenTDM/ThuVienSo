@model ThuVienSo.Models.ViewModels.DoiMatKhauViewModel
@{
    ViewBag.Title = "Đổi mật khẩu";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex mb-3">
                    <i class="bi bi-shield-lock display-5"></i>
                </div>
                <h4 class="fw-bold text-dark mb-1">Đổi mật khẩu</h4>
                <p class="text-muted small mb-0">Mật khẩu mới được băm bằng PBKDF2 trước khi lưu vào cơ sở dữ liệu.</p>
            </div>

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger small py-2" })

            @using (Html.BeginForm("DoiMatKhau", "Account", FormMethod.Post, new { @class = "row g-3" }))
            {
                @Html.AntiForgeryToken()

                <div class="col-12">
                    @Html.LabelFor(m => m.MatKhauCu, new { @class = "form-label fw-bold" })
                    @Html.PasswordFor(m => m.MatKhauCu, new { @class = "form-control", placeholder = "Nhập mật khẩu hiện tại", autofocus = "autofocus" })
                    @Html.ValidationMessageFor(m => m.MatKhauCu, "", new { @class = "text-danger small d-block" })
                </div>

                <div class="col-12">
                    @Html.LabelFor(m => m.MatKhauMoi, new { @class = "form-label fw-bold" })
                    @Html.PasswordFor(m => m.MatKhauMoi, new { @class = "form-control", placeholder = "Từ 6 đến 100 ký tự" })
                    @Html.ValidationMessageFor(m => m.MatKhauMoi, "", new { @class = "text-danger small d-block" })
                </div>

                <div class="col-12">
                    @Html.LabelFor(m => m.XacNhanMatKhauMoi, new { @class = "form-label fw-bold" })
                    @Html.PasswordFor(m => m.XacNhanMatKhauMoi, new { @class = "form-control", placeholder = "Nhập lại mật khẩu mới" })
                    @Html.ValidationMessageFor(m => m.XacNhanMatKhauMoi, "", new { @class = "text-danger small d-block" })
                </div>

                <div class="col-12 d-grid d-md-flex gap-2 justify-content-md-end">
                    <a href="@Url.Action("HoSoCaNhan", "Account")" class="btn btn-outline-secondary fw-bold px-4 rounded-3">
                        <i class="bi bi-arrow-left me-1"></i>Quay lại
                    </a>
                    <button type="submit" class="btn btn-primary fw-bold px-4 rounded-3">
                        <i class="bi bi-check2-circle me-1"></i>Cập nhật mật khẩu
                    </button>
                </div>
            }
        </div>
    </div>
</div>
