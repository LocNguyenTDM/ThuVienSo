@model ThuVienSo.Models.ViewModels.CapNhatHoSoViewModel
@{
    ViewBag.Title = "Thông tin cá nhân";

    var vaiTro = ViewBag.VaiTro as string;
    var trangThai = ViewBag.TrangThai as string;
    var nhanVaiTro = vaiTro == ThuVienSo.Models.HangSoHeThong.VaiTro.Admin
        ? "Quản trị viên"
        : (vaiTro == ThuVienSo.Models.HangSoHeThong.VaiTro.ThuThu ? "Thủ thư" : "Độc giả");
    var dangHoatDong = trangThai == ThuVienSo.Models.HangSoHeThong.TrangThaiNguoiDung.HoatDong;
}

<div class="mb-4">
    <h2 class="fw-bold text-dark mb-2"><i class="bi bi-person-vcard text-primary me-2"></i>Thông Tin Cá Nhân</h2>
    <p class="text-muted mb-0">Cập nhật họ tên và số điện thoại dùng cho tài khoản đọc tài liệu của bạn.</p>
</div>

@if (TempData["ThongBaoThanhCong"] != null)
{
    <div class="alert alert-success rounded-4 d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["ThongBaoThanhCong"]</span>
    </div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center h-100">
            <div class="bg-primary text-white p-3 rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-person-fill display-5"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">@Model.HoTen</h5>
            <p class="text-muted small mb-3">@Model.Email</p>
            <div class="d-flex justify-content-center gap-2 mb-3">
                <span class="badge bg-primary">@nhanVaiTro</span>
                @if (dangHoatDong)
                {
                    <span class="badge bg-success">Đang hoạt động</span>
                }
                else
                {
                    <span class="badge bg-danger">Đã bị khóa</span>
                }
            </div>
            <div class="d-grid gap-2">
                <a href="@Url.Action("DoiMatKhau", "Account")" class="btn btn-outline-primary fw-bold rounded-3">
                    <i class="bi bi-key me-1"></i>Đổi mật khẩu
                </a>
                <a href="@Url.Action("Index", "NguoiDoc")" class="btn btn-outline-secondary fw-bold rounded-3">
                    <i class="bi bi-journal-bookmark me-1"></i>Tủ sách của tôi
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger small py-2" })

            @using (Html.BeginForm("HoSoCaNhan", "Account", FormMethod.Post, new { @class = "row g-3" }))
            {
                @Html.AntiForgeryToken()

                <div class="col-12">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @readonly = "readonly" })
                    <div class="form-text">Email là tài khoản đăng nhập nên không thể thay đổi.</div>
                </div>

                <div class="col-12">
                    @Html.LabelFor(m => m.HoTen, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", placeholder = "Nguyễn Văn A" })
                    @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "text-danger small d-block" })
                </div>

                <div class="col-12">
                    @Html.LabelFor(m => m.SoDienThoai, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control", placeholder = "0901234567" })
                    @Html.ValidationMessageFor(m => m.SoDienThoai, "", new { @class = "text-danger small d-block" })
                </div>

                <div class="col-12 d-grid d-md-flex gap-2 justify-content-md-end">
                    <a href="@Url.Action("Index", "NguoiDoc")" class="btn btn-outline-secondary fw-bold px-4 rounded-3">
                        <i class="bi bi-x-lg me-1"></i>Huỷ
                    </a>
                    <button type="submit" class="btn btn-primary fw-bold px-4 rounded-3">
                        <i class="bi bi-save me-1"></i>Lưu thay đổi
                    </button>
                </div>
            }
        </div>
    </div>
</div>
