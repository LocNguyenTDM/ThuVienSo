@{
    ViewBag.Title = "Báo cáo lưu lượng đọc & tải tài liệu";

    var tuNgay = (DateTime)(ViewBag.TuNgay ?? DateTime.Today.AddDays(-29));
    var denNgay = (DateTime)(ViewBag.DenNgay ?? DateTime.Today);
    var hanhDong = ViewBag.HanhDong as string;

    var tongLuotXem = (int)(ViewBag.TongLuotXem ?? 0);
    var tongLuotTai = (int)(ViewBag.TongLuotTai ?? 0);
    var soGiaoDich = (int)(ViewBag.SoGiaoDich ?? 0);
    var doanhThu = (long)(ViewBag.DoanhThu ?? 0L);
    var topTaiLieu = ViewBag.TopTaiLieu as List<ThongKeTaiLieu> ?? new List<ThongKeTaiLieu>();
    var nhatKy = ViewBag.NhatKy as List<LichSuTaiLieu> ?? new List<LichSuTaiLieu>();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-bar-chart-line text-success me-2"></i>Báo cáo lưu lượng Đọc / Tải</h2>
            <p class="text-muted mb-0">Thống kê lượt đọc, lượt tải, giao dịch mua quyền và doanh thu theo khoảng thời gian.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("XuatBaoCaoLuuLuong", "ThuThu", new { tuNgay = tuNgay.ToString("yyyy-MM-dd"), denNgay = denNgay.ToString("yyyy-MM-dd"), hanhDong = hanhDong })"
               class="btn btn-success rounded-pill fw-bold">
                <i class="bi bi-file-earmark-arrow-down me-1"></i>Xuất Excel (.xlsx)
            </a>
            <a href="@Url.Action("Index", "ThuThu")" class="btn btn-outline-secondary rounded-pill fw-bold">
                <i class="bi bi-arrow-left me-1"></i>Quay lại
            </a>
        </div>
    </div>

    @if (ViewBag.LoiKetNoi != null)
    {
        <div class="alert alert-danger rounded-4 border-0 shadow-sm mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.LoiKetNoi
        </div>
    }

    <!-- Bộ lọc -->
    <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
        <div class="card-body">
            @using (Html.BeginForm("BaoCaoLuuLuong", "ThuThu", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
            {
                <div class="col-md-3">
                    <label class="form-label fw-semibold small">Từ ngày</label>
                    <input type="date" name="tuNgay" value="@tuNgay.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small">Đến ngày</label>
                    <input type="date" name="denNgay" value="@denNgay.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small">Hành động</label>
                    <select name="hanhDong" class="form-select">
                        <option value="">-- Tất cả hành động --</option>
                        <option value="XEM" @(hanhDong == "XEM" ? "selected" : null)>Chỉ lượt đọc (XEM)</option>
                        <option value="TAI" @(hanhDong == "TAI" ? "selected" : null)>Chỉ lượt tải (TAI)</option>
                    </select>
                </div>
                <div class="col-md-3 d-grid">
                    <button type="submit" class="btn btn-primary fw-bold"><i class="bi bi-funnel me-1"></i>Xem báo cáo</button>
                </div>
            }
        </div>
    </div>

    <!-- Số liệu tổng hợp -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card lib-card p-3 bg-white border-start border-success border-4">
                <span class="text-muted small fw-semibold">Tổng lượt đọc</span>
                <h3 class="fw-bold text-success my-1">@tongLuotXem.ToString("#,##0") <span class="fs-6 fw-normal text-muted">lượt</span></h3>
                <small class="text-muted">Từ @tuNgay.ToString("dd/MM/yyyy") đến @denNgay.ToString("dd/MM/yyyy")</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card lib-card p-3 bg-white border-start border-danger border-4">
                <span class="text-muted small fw-semibold">Tổng lượt tải</span>
                <h3 class="fw-bold text-danger my-1">@tongLuotTai.ToString("#,##0") <span class="fs-6 fw-normal text-muted">lượt</span></h3>
                <small class="text-muted">Từ @tuNgay.ToString("dd/MM/yyyy") đến @denNgay.ToString("dd/MM/yyyy")</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card lib-card p-3 bg-white border-start border-primary border-4">
                <span class="text-muted small fw-semibold">Giao dịch thành công</span>
                <h3 class="fw-bold text-primary my-1">@soGiaoDich.ToString("#,##0") <span class="fs-6 fw-normal text-muted">giao dịch</span></h3>
                <small class="text-muted">Lượt mua quyền tài liệu</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card lib-card p-3 bg-white border-start border-warning border-4">
                <span class="text-muted small fw-semibold">Doanh thu</span>
                <h3 class="fw-bold text-warning my-1">@doanhThu.ToString("#,##0") đ</h3>
                <small class="text-muted">Tổng tiền giao dịch thành công</small>
            </div>
        </div>
    </div>

    <!-- Top tài liệu -->
    <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
        <div class="card-body">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-trophy text-warning me-2"></i>Tài liệu được đọc/tải nhiều nhất trong kỳ</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:60px;">#</th>
                            <th>Tên tài liệu</th>
                            <th class="text-center">Lượt đọc</th>
                            <th class="text-center">Lượt tải</th>
                            <th class="text-center">Tổng lượt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (topTaiLieu.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">Chưa có dữ liệu đọc/tải trong khoảng thời gian này.</td>
                            </tr>
                        }
                        else
                        {
                            var thuTu = 0;
                            foreach (var item in topTaiLieu)
                            {
                                thuTu++;
                                <tr>
                                    <td class="fw-bold text-muted">@thuTu</td>
                                    <td class="fw-semibold text-dark">@item.TenTaiLieu</td>
                                    <td class="text-center"><span class="badge bg-success bg-opacity-10 text-success">@item.LuotXem</span></td>
                                    <td class="text-center"><span class="badge bg-danger bg-opacity-10 text-danger">@item.LuotTai</span></td>
                                    <td class="text-center fw-bold text-primary">@item.TongLuot</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Nhật ký chi tiết -->
    <div class="card border-0 shadow-sm rounded-4 bg-white">
        <div class="card-body">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-journal-text text-primary me-2"></i>Nhật ký đọc / tải chi tiết</h5>
            <div class="table-responsive" style="max-height: 520px; overflow-y: auto;">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th class="ps-3">Thời gian</th>
                            <th>Độc giả</th>
                            <th>Tài liệu</th>
                            <th class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (nhatKy.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Không có lượt đọc/tải nào được ghi nhận trong khoảng thời gian này.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in nhatKy)
                            {
                                <tr>
                                    <td class="ps-3 text-nowrap">@item.ThoiGian.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@(item.NguoiDung != null && !string.IsNullOrEmpty(item.NguoiDung.HoTen) ? item.NguoiDung.HoTen : "Người dùng #" + item.UserId)</div>
                                        <small class="text-muted">@(item.NguoiDung != null ? item.NguoiDung.Email : null)</small>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@(item.TaiLieu != null ? item.TaiLieu.TenTaiLieu : "Tài liệu #" + item.TaiLieuId)</div>
                                        <small class="text-muted">@(item.TaiLieu != null && item.TaiLieu.TheLoai != null ? item.TaiLieu.TheLoai.TenTheLoai : null)</small>
                                    </td>
                                    <td class="text-center">
                                        @if (item.HanhDong == HangSoHeThong.HanhDongTaiLieu.Tai)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger"><i class="bi bi-download me-1"></i>Tải</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success"><i class="bi bi-book me-1"></i>Đọc</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (nhatKy.Count >= 50)
            {
                <div class="form-text mt-2">Chỉ hiển thị 50 lượt gần nhất. Hãy thu hẹp khoảng thời gian để xem chi tiết hơn.</div>
            }
        </div>
    </div>
</div>
