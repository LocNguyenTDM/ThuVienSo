@model GiaoDich
@{
    ViewBag.Title = "Chi tiết giao dịch #" + Model.Id;

    var quyenTai = ViewBag.QuyenTai as QuyenTaiLieu;
    var nguoiMua = Model.NguoiDung;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold text-dark mb-1"><i class="bi bi-receipt text-success me-2"></i>Chi Tiết Giao Dịch #@Model.Id</h2>
        <p class="text-muted mb-0">Thông tin người mua, tài liệu, số tiền và quyền tải được cấp kèm giao dịch.</p>
    </div>
    <a href="@Url.Action("GiaoDich", "Admin")" class="btn btn-outline-secondary rounded-pill fw-bold">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
    </a>
</div>

@Html.Partial("_AdminNav")

<div class="row g-4">
    <!-- Thông tin giao dịch -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-info-circle text-primary me-2"></i>Thông tin giao dịch</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold">Mã giao dịch</div>
                        <div class="fw-bold text-dark fs-5">#@Model.Id</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold">Trạng thái</div>
                        <div>
                            @if (Model.DaThanhCong)
                            {
                                <span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>Thành công</span>
                            }
                            else if (Model.TrangThai == HangSoHeThong.TrangThaiGiaoDich.DangXuLy)
                            {
                                <span class="badge bg-warning text-dark fs-6"><i class="bi bi-hourglass-split me-1"></i>Đang xử lý</span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-6"><i class="bi bi-x-circle me-1"></i>Thất bại</span>
                            }
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold">Số tiền</div>
                        <div class="fw-bold text-danger fs-5">@((Model.SoTien ?? 0).ToString("#,##0")) đ</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold">Thời gian giao dịch</div>
                        <div class="fw-semibold text-dark">
                            @(Model.NgayGiaoDich.HasValue ? Model.NgayGiaoDich.Value.ToString("dd/MM/yyyy HH:mm:ss") : "Chưa ghi nhận")
                        </div>
                    </div>
                    <div class="col-12"><hr class="my-1" /></div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold">Người mua</div>
                        <div class="fw-bold text-dark">@(nguoiMua != null ? nguoiMua.TenHienThi : "Không xác định")</div>
                        <small class="text-muted">@(nguoiMua != null ? nguoiMua.Email : "Mã người dùng #" + Model.UserId)</small>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold">Vai trò / Trạng thái tài khoản</div>
                        @if (nguoiMua != null)
                        {
                            var vaiTroBadge = nguoiMua.LaAdmin ? "bg-danger" : (nguoiMua.LaThuThu ? "bg-success" : "bg-primary");
                            <div class="mb-1">
                                <span class="badge @vaiTroBadge">@nguoiMua.NhanVaiTro</span>
                            </div>
                            if (nguoiMua.DangHoatDong)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger">Đã bị khóa</span>
                            }
                        }
                        else
                        {
                            <div class="text-muted">Không có dữ liệu</div>
                        }
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold">Tài liệu</div>
                        <div class="fw-bold text-dark">@(Model.TaiLieu != null ? Model.TaiLieu.TenTaiLieu : "Tài liệu #" + Model.TaiLieuId)</div>
                        @if (Model.TaiLieu != null)
                        {
                            <small class="text-muted">Giá niêm yết: @Model.TaiLieu.GiaHienThi</small>
                        }
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold">Mã tài liệu</div>
                        <div class="fw-semibold text-dark">#@Model.TaiLieuId</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quyền tải -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-shield-check text-success me-2"></i>Quyền tải tài liệu</h5>
            </div>
            <div class="card-body d-flex flex-column">
                @if (!Model.DaThanhCong)
                {
                    <div class="alert alert-warning rounded-3 small mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        Giao dịch chưa thành công nên hệ thống không cấp quyền tải cho người mua.
                    </div>
                }
                else if (quyenTai == null)
                {
                    <div class="alert alert-secondary rounded-3 small mb-0">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        Giao dịch thành công nhưng không tìm thấy bản ghi quyền tải tương ứng.
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <div class="text-muted small fw-semibold">Trạng thái quyền</div>
                        @if (quyenTai.ConHieuLuc)
                        {
                            <span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>Còn hiệu lực</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6"><i class="bi bi-slash-circle me-1"></i>Đã thu hồi</span>
                        }
                    </div>
                    <div class="mb-3">
                        <div class="text-muted small fw-semibold">Ngày cấp</div>
                        <div class="fw-semibold text-dark">
                            @(quyenTai.NgayCap == default(DateTime)
                                ? "Không xác định (quyền được cấp từ giao dịch trước đó)"
                                : quyenTai.NgayCap.ToString("dd/MM/yyyy HH:mm"))
                        </div>
                    </div>
                    <div class="mt-auto">
                        <div class="alert alert-info rounded-3 small mb-0">
                            <i class="bi bi-info-circle-fill me-1"></i>
                            Quyền tải được cấp tự động bởi cơ sở dữ liệu sau khi giao dịch chuyển sang trạng thái <strong>THANH_CONG</strong>.
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
