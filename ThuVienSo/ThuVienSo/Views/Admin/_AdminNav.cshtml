@{
    var hanhDongHienTai = (ViewContext.RouteData.Values["action"] as string) ?? "Index";
}

<div class="card border-0 shadow-sm rounded-4 bg-white p-2 mb-4">
    <ul class="nav nav-pills gap-2 flex-wrap">
        <li class="nav-item">
            <a class="nav-link rounded-pill fw-bold @(hanhDongHienTai == "Index" ? "active" : "text-dark")"
               href="@Url.Action("Index", "Admin")">
                <i class="bi bi-speedometer2 me-1"></i>Tổng quan
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill fw-bold @(hanhDongHienTai == "QuanLyNguoiDung" ? "active" : "text-dark")"
               href="@Url.Action("QuanLyNguoiDung", "Admin")">
                <i class="bi bi-people-fill me-1"></i>Người dùng &amp; phân quyền
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill fw-bold @(hanhDongHienTai == "GiaoDich" || hanhDongHienTai == "ChiTietGiaoDich" ? "active" : "text-dark")"
               href="@Url.Action("GiaoDich", "Admin")">
                <i class="bi bi-receipt me-1"></i>Giao dịch
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill fw-bold @(hanhDongHienTai == "BaoCaoThongKe" ? "active" : "text-dark")"
               href="@Url.Action("BaoCaoThongKe", "Admin")">
                <i class="bi bi-bar-chart-line-fill me-1"></i>Thống kê &amp; doanh thu
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill fw-bold @(hanhDongHienTai == "NhatKyHoatDong" ? "active" : "text-dark")"
               href="@Url.Action("NhatKyHoatDong", "Admin")">
                <i class="bi bi-journal-text me-1"></i>Nhật ký hoạt động
            </a>
        </li>
    </ul>
</div>
